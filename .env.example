# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Set to "true" to force SSL, "false" to disable SSL. Supabase URLs use SSL by default.
DATABASE_SSL=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Used by server/admin scripts. Keep this secret, even though the current code reads it via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# App authentication
APP_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
# Session duration in seconds. Default: 86400 (24 hours).
SESSION_DURATION=86400

# Queue worker / cron
CRON_SECRET=replace-with-a-long-random-secret
# Used by the dashboard client when manually triggering the worker.
NEXT_PUBLIC_CRON_SECRET=replace-with-the-same-value-as-CRON_SECRET
# Used by npm run worker. Default: 60000.
QUEUE_WORKER_INTERVAL_MS=60000

# Gmail OAuth
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/google/callback
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Apify email verification
APIFY_API_KEY=your-apify-api-token
APIFY_ACTOR_ID=yasir-on-apify/email-verifier-deliverability-checker
APIFY_USER_ID=your-apify-user-id
APIFY_TIMEOUT_MS=300000
APIFY_MAX_RETRIES=3
APIFY_BATCH_SIZE=10
APIFY_RECHECK_DAYS=30

# Webhooks
WEBHOOK_SECRET=your-webhook-signing-secret
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=100
# Base URL used by the queue worker and webhook examples.
APP_URL=http://localhost:3000

# Optional / currently present in local env
OPENROUTER_API_KEY=your-openrouter-api-key
