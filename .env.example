# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Set to "true" to force SSL, "false" to disable SSL. Supabase URLs use SSL by default.
DATABASE_SSL=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Used by server/admin scripts. Keep this secret, even though the current code reads it via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# App authentication
APP_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
# Session duration in seconds. Default: 86400 (24 hours).
SESSION_DURATION=86400

# Queue worker / BullMQ
# Base app URL used by workers/jobs.
APP_URL=http://localhost:3000
# Redis/Valkey connection string used by BullMQ and queue locks.
REDIS_URL=rediss://default:your-valkey-password@your-valkey-host:your-port
# BullMQ queue name.
BULLMQ_QUEUE_NAME=email-processing
# BullMQ job name for queue processing.
BULLMQ_PROCESS_JOB_NAME=process-due-email-queue
# Repeatable timer key.
BULLMQ_REPEAT_KEY=email-processing-repeat
# Centralized repeat timer interval in ms.
BULLMQ_PROCESS_INTERVAL_MS=60000
# BullMQ worker concurrency.
BULLMQ_WORKER_CONCURRENCY=1
# Auto-create repeat timer when worker starts.
BULLMQ_AUTO_SCHEDULE_ON_START=true
# Used by the legacy worker path. Default: 60000.
QUEUE_WORKER_INTERVAL_MS=60000

# Gmail OAuth
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/google/callback
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Apify email verification
APIFY_API_KEY=your-apify-api-token
APIFY_ACTOR_ID=yasir-on-apify/email-verifier-deliverability-checker
APIFY_USER_ID=your-apify-user-id
APIFY_TIMEOUT_MS=300000
APIFY_MAX_RETRIES=3
APIFY_BATCH_SIZE=10
APIFY_RECHECK_DAYS=30

# Webhooks
WEBHOOK_SECRET=your-webhook-signing-secret
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=100

# Optional / currently present in local env
OPENROUTER_API_KEY=your-openrouter-api-key

# Resend API (HTTP-based email sending - primary method, works on Railway)
RESEND_API_KEY=re_your-resend-api-key
